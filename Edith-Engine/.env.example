# ==============================================================================
# Edith Engine — Environment Configuration
# ==============================================================================
# Copy this file to .env in your repository root or to ~/.edith/.env:
#   cp .env.example .env
#
# Edith automatically reads .env upon startup if present.
# Note: .env is excluded from git tracking in .gitignore.
# ==============================================================================

# Required: Groq API Key (get yours at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Groq Model identifier (default: llama-3.3-70b-versatile)
# Supported options include: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Local server bind address (default: 127.0.0.1:8080)
EDITH_ADDR=127.0.0.1:8080

# Optional: Context package byte budget for evidence retrieval (default: 16384)
EDITH_MAX_CONTEXT_BYTES=16384

# Optional: Obsidian Web Clipper auto-processing folders (vault-relative)
# Edith watches Clippings and 02-Raw-Sources/Web-Clips by default.
EDITH_CLIPPER_INBOX=Clippings
EDITH_CLIPPER_OUTPUT=Processed
