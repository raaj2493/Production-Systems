<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#FBF9F5">

    <!-- Blocked App Icon & Header -->
    <ImageView
        android:id="@+id/ivBlockedAppIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="Blocked Application Icon"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvBlockedAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Application Blocked"
        android:textSize="14sp"
        android:textColor="#8E8E93"
        android:fontFamily="sans-serif-medium" />

    <View
        android:layout_width="match_parent"
        android:layout_height="28dp" />

    <!-- Areté Focus Shield Core Message -->
    <TextView
        android:id="@+id/tvHeadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stay with your intention."
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:fontFamily="sans-serif-medium"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="This app is blocked during your focus session.\nReturn to your task. Your focus is still in progress."
        android:textSize="15sp"
        android:textColor="#555555"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- Session Countdown Pill -->
    <TextView
        android:id="@+id/tvTimerCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_timer_pill"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Focus remaining: --:--"
        android:textColor="#1C1C1E"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium" />

    <View
        android:layout_width="match_parent"
        android:layout_height="40dp" />

    <!-- Primary Action: Return to Areté -->
    <Button
        android:id="@+id/btnReturnToArete"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_sage_button"
        android:text="Return to Areté"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null" />

    <!-- Short-Form Content Quick Pass Options (Hidden by default, shown for Shorts/Reels) -->
    <LinearLayout
        android:id="@+id/llQuickPassContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Need a quick break? Watch for a little time:"
            android:textColor="#71717A"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnQuickPass2Min"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_timer_pill"
                android:text="2 Mins"
                android:textColor="#1C1C1E"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnQuickPass5Min"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_timer_pill"
                android:text="5 Mins"
                android:textColor="#1C1C1E"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnQuickPass10Min"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="@drawable/bg_timer_pill"
                android:text="10 Mins"
                android:textColor="#1C1C1E"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- Secondary / Emergency Exit Action -->
    <TextView
        android:id="@+id/tvEmergencyExit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:text="Emergency Exit"
        android:textColor="#8E8E93"
        android:textSize="14sp" />

</LinearLayout>
